# Copy this file to .env and fill in what you have. Leave blank what you skip.
# .env is git-ignored - never commit it or paste secrets in chat.

# Kaggle (required) - dataset download
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=

# MOSDAC (optional) - live INSAT-3D/3DR imagery
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# NASA Earthdata (optional) - GPM IMERG rainfall
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus CDS (optional) - ERA5 shear/humidity/vorticity
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=

# LLM (optional) - bulletin text; template fallback if blank
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Mapbox (optional) - Leaflet + OpenStreetMap used if blank
NEXT_PUBLIC_MAPBOX_TOKEN=
